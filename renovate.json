{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":configMigration",
    ":separateMultipleMajorReleases",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Africa/Lubumbashi",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 8,
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Require explicit dashboard approval for every major upgrade",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Hold TypeScript below 7 until typescript-eslint supports it (typescript-eslint#10940); TS 7 removes the JS compiler API that scripts/audit-type-escapes.mjs uses and makes typescript-eslint throw on load, which takes lint and the type-escape ratchet down repo-wide.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Require explicit approval for database, authentication, document-generation, and spreadsheet runtime dependencies",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "drizzle-orm",
        "drizzle-kit",
        "pg",
        "express",
        "express-session",
        "connect-pg-simple",
        "passport",
        "passport-local",
        "@simplewebauthn/browser",
        "@simplewebauthn/server",
        "bcryptjs",
        "zod",
        "xlsx",
        "xlsx-js-style",
        "exceljs",
        "pdfkit",
        "jspdf",
        "jspdf-autotable"
      ],
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Group non-major development-tool updates to reduce PR noise",
      "matchDatasources": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "7 days",
      "groupName": "development dependencies",
      "automerge": false
    },
    {
      "description": "Group production patch updates while keeping them review-gated",
      "matchDatasources": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "7 days",
      "groupName": "production dependency patches",
      "automerge": false
    },
    {
      "description": "Keep GitHub Actions digest updates isolated and review-gated",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions digests",
      "automerge": false
    }
  ]
}
