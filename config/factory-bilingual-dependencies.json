  "scope": "Factory bale product/category names, article codes, snapshots, and linked documents",
  "rules": {
    "languages": ["en", "ar"],
    "articleCodeMatch": "company-scoped trim-plus-uppercase exact match; preserve punctuation and leading zeroes",
    "liveFallback": "requested language, opposite language, article code",
    "finalizedFallback": "requested snapshot, opposite snapshot, requested catalog, opposite catalog, article code",
    "historicalRule": "finalized documents must not be silently renamed by later catalog edits",
