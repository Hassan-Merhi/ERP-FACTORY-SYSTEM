# Copy to deploy/lan/.env on the FACTORY SERVER only (chmod 600).
# Never commit the populated file or the TLS private key.
EDGE_SITE_ID=REPLACE_WITH_NEW_UUID
EDGE_HOSTNAME=erp.factory.internal
EDGE_BIND_IP=192.168.1.100

# Phase 6 staging certification: operator-entered exact release SHA, not a signature.
EDGE_RELEASE_SHA=

# Generate separate secrets. Example:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
EDGE_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
EDGE_SESSION_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_64_CHAR_SECRET

# Default: no business mutations. Phase 4 must fence cloud writes before any
# exclusive LAN-primary cutover. Never enter the acknowledgment prematurely.
EDGE_WRITE_MODE=read-only
EDGE_PRIMARY_ACK=

# Public age recipient for encrypted local backups; private identity stays elsewhere.
EDGE_BACKUP_AGE_RECIPIENT=

# Phase 4: optional ciphertext-only staging to private rclone object storage.
# Configure a private remote on the factory host (e.g., "s3:erp-edge-checkpoints").
# These are NOT cloud ERP database replication settings.
EDGE_SYNC_REMOTE=
# Use an independent random key (48+ chars), retain securely for restore verification.
EDGE_SYNC_SIGNING_KEY=

# Opt-in staging-only relay: enable with docker compose --profile sync up -d.
# Cloud MUST be explicitly fenced and have its HMAC staging receiver enabled.
# Never reuse the age backup signing key for FACTORY_SYNC_HMAC_KEY.
EDGE_SYNC_CLOUD_URL=
EDGE_SYNC_API_KEY=
