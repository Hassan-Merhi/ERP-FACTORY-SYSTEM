# Phase 6: exact deployed commit (40-character lowercase SHA). Empty until deployment is certified.
# Set only after building the reviewed release SHA; never treat this operator value as a signature.
EDGE_RELEASE_SHA=

# Copy to deploy/lan/.env on the FACTORY SERVER only (chmod 600).
# Never commit the populated file or the TLS private key.
EDGE_SITE_ID=REPLACE_WITH_NEW_UUID
EDGE_HOSTNAME=erp.factory.internal
EDGE_BIND_IP=192.168.1.100

# Generate separate secrets. Example:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
EDGE_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
EDGE_SESSION_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_64_CHAR_SECRET

# Default: no business mutations. Phase 4 must fence cloud writes before any
# exclusive LAN-primary cutover. Never enter the acknowledgment prematurely.
EDGE_WRITE_MODE=read-only
EDGE_PRIMARY_ACK=
# Phase 7 only, after independently verified restore, restricted DB user, and
# DBA-installed transaction fence; leave both EMPTY in read-only deployment.
EDGE_WRITER_EPOCH=
EDGE_BASELINE_SHA256=

# Public age recipient for encrypted local backups; private identity stays elsewhere.
EDGE_BACKUP_AGE_RECIPIENT=
