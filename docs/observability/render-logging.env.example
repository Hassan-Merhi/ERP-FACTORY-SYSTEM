# Render logging and request-performance controls
#
# These variables supplement the root .env.example with the settings owned by
# the readable production logging subsystem. Copy only the overrides needed by
# the deployment; every value below has the shown production default.

# debug | info | warn | error                         (default: info in production)
LOG_LEVEL=info

# pretty | json                                      (default: pretty on Render)
LOG_FORMAT=pretty

# Keep false so the shared Express request logger is authoritative.
# Set true only for temporary low-level bootstrap diagnostics. (default: false)
RUNTIME_OBSERVABILITY_REQUEST_LOGS=false

# Legacy/default normal-API threshold override.      (default: 1000)
SLOW_REQUEST_MS=1000

# Endpoint-aware slow-request thresholds in milliseconds.
SLOW_REQUEST_DEFAULT_MS=1000
SLOW_REQUEST_PDF_MS=3000
SLOW_REQUEST_WHATSAPP_MS=5000
SLOW_REQUEST_REPORT_EXPORT_MS=5000
SLOW_REQUEST_BACKGROUND_JOB_MS=10000

# Large-response warning thresholds in kilobytes.
BANDWIDTH_DEBUG_THRESHOLD_KB=500
BANDWIDTH_DEBUG_STATIC_THRESHOLD_KB=2048
BANDWIDTH_DEBUG_DOCUMENT_THRESHOLD_KB=10240

# Number of endpoint rows included in a Render summary. Values above 5 are
# capped; the full ranking remains in GET /api/health/metrics. (default: 3)
BANDWIDTH_DEBUG_LOG_TOP_N=3

# ── One-time production schema repair controls ───────────────────────────────
# Wave 3 only: enable for one manual deployment to create/verify the sales
# hot-path indexes, then return to false after production verification.
# This does NOT enable the general startup migration coordinator. (default: false)
RUN_WAVE3_INDEX_REPAIR=false

# ── Sensitive-value redaction ────────────────────────────────────────────────
# Redaction is ON by default and always on when NODE_ENV=production. Set to
# exactly "false" outside production to see unredacted log payloads while
# debugging locally.                                   (default: true)
LOG_REDACT_SENSITIVE=true

# ── Log alert dispatch ───────────────────────────────────────────────────────
# Forwards warn/error log events to a webhook. Dispatch happens only when
# LOG_ALERTS_ENABLED is exactly "true" AND LOG_ALERT_WEBHOOK_URL is non-empty;
# either one alone is inert.
LOG_ALERTS_ENABLED=false

# Destination for alert payloads. Required to enable dispatch.
LOG_ALERT_WEBHOOK_URL=

# Sent as `Authorization: Bearer <token>` when set. Leave empty for an
# unauthenticated webhook.
LOG_ALERT_WEBHOOK_BEARER_TOKEN=

# warning | critical. "critical" suppresses warning-level events so only
# critical ones are dispatched.                        (default: warning)
LOG_ALERT_MIN_SEVERITY=warning

# Milliseconds a repeated alert signature is suppressed after being sent.
#                                                      (default: 300000)
LOG_ALERT_COOLDOWN_MS=300000

# Milliseconds before an in-flight webhook POST is aborted. (default: 5000)
LOG_ALERT_TIMEOUT_MS=5000
