# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration
#
# Copy to .env and fill in the values you need. Only the variables under
# "Required" must be set — everything else has a working default, shown as
# "(default: …)". Variables with no default are features that stay disabled
# until you configure them.
#
# This file lists every variable the server reads at runtime. Variables used
# only by one-off audit and smoke-test scripts under scripts/ are documented
# alongside those scripts, not here.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# Required
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string.
# Example: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db

# Secret used to sign session cookies. The server refuses to start in
# production without it. Generate a long random string — never reuse the
# example value.
SESSION_SECRET=change-this-to-a-random-secret-in-production


# ═══════════════════════════════════════════════════════════════════════════
# Core application
# ═══════════════════════════════════════════════════════════════════════════

# development | production | test          (default: development)
NODE_ENV=development

# HTTP port                                (default: 5000)
PORT=5000

# Version string reported by GET /api/build-info. Falls back to the first
# characters of RENDER_GIT_COMMIT, then to "dev".
# BUILD_VERSION=

# Run the startup migration coordinator on boot.
# "false" skips it — the schema must already be current.   (default: true)
# RUN_STARTUP_MIGRATIONS=true

# Run background schedulers (cron jobs, tracking refresh, cleanup).
# Set to "false" in CI and test environments.               (default: true)
# ENABLE_SCHEDULERS=true

# Milliseconds to cache the readiness schema probe used by
# GET /api/health/ready.                                    (default: 30000)
# READINESS_SCHEMA_CACHE_MS=30000


# ═══════════════════════════════════════════════════════════════════════════
# Database connection (alternative to DATABASE_URL)
# ═══════════════════════════════════════════════════════════════════════════
# If DATABASE_URL is unset, the connection string is assembled from these.
# Prefer DATABASE_URL; these exist for platforms that inject discrete vars.

# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Set to "disable" to turn off TLS for the database connection. Any other
# value (or unset) keeps TLS on.                            (default: unset)
# PGSSLMODE=

# TLS certificate verification for the database connection. By default the
# server connects with TLS but does NOT verify the server certificate
# (rejectUnauthorized: false) and logs a one-time startup warning. To verify
# the certificate chain, set exactly one of the following:
#
#   PGSSLROOTCERT — path to the CA bundle (PEM) that signs your database's
#   certificate. When set, the connection verifies against this CA. A wrong or
#   unreadable path fails fast at boot rather than silently downgrading.
# PGSSLROOTCERT=
#
#   PGSSL_REJECT_UNAUTHORIZED — set to true/1/yes/on to verify against the
#   system trust store (use when the platform already provides a trusted
#   chain). Ignored when PGSSLROOTCERT is set.            (default: unset)
# PGSSL_REJECT_UNAUTHORIZED=

# ── Connection pool ────────────────────────────────────────────────────────
# Each value is clamped to the range shown; out-of-range input falls back to
# the default rather than being rejected.

# Max connections in the main pool. Range 1–100.            (default: 10)
# PG_POOL_MAX=10

# Min idle connections kept open. Range 0–20, capped at PG_POOL_MAX.
#                                                           (default: 2)
# PG_POOL_MIN=2

# Milliseconds to wait for a free connection. Range 1000–60000. (default: 8000)
# PG_CONNECTION_TIMEOUT_MS=8000

# Milliseconds an idle connection is kept. Range 10000–600000. (default: 120000)
# PG_IDLE_TIMEOUT_MS=120000

# Server-side statement timeout in ms. Range 1000–120000.   (default: 30000)
# PG_STATEMENT_TIMEOUT_MS=30000

# Queries slower than this many ms are logged. Range 100–60000. (default: 1000)
# PG_SLOW_QUERY_MS=1000

# Max connections in the separate pool backing the session store. (default: 3)
# PG_SESSION_POOL_MAX=3

# ── Startup migration lock ─────────────────────────────────────────────────
# Serialises startup migrations across instances via an advisory lock, so two
# booting servers cannot migrate concurrently.

# Milliseconds to wait for the lock before giving up.       (default: 90000)
# STARTUP_MIGRATION_LOCK_WAIT_MS=90000

# Milliseconds between lock acquisition attempts.           (default: 1000)
# STARTUP_MIGRATION_LOCK_POLL_MS=1000

# Set to "true" to boot anyway when the lock cannot be acquired. Leave off
# unless you are recovering from a stuck lock — it permits concurrent
# migrations, which is the thing the lock exists to prevent. (default: false)
# STARTUP_MIGRATION_LOCK_FAIL_OPEN=false


# ═══════════════════════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════════════════════

# CSRF synchroniser-token enforcement.
# "0"  → warn-only: mismatches are logged but the request proceeds.
# Any other value → hard 403 on mismatch.                   (default: enforcing)
# Use "0" only as a temporary escape hatch if a regression surfaces.
# CSRF_ENFORCE=1

# Content-Security-Policy enforcement.
# Unset → the policy ships report-only in production (violations are logged
# via /api/csp-report without blocking) and off elsewhere.
# "true" → the same policy is enforced (blocking). Flip this only after the
# report stream is clean; to preview enforcement locally, set it in
# development and watch the server logs while clicking through the app.
# CSP_ENFORCE=true

# ── Global API rate limiting ───────────────────────────────────────────────
# Baseline flood guard for /api/* routes. Signed-in callers are bucketed per
# user (sites share NAT IPs, so IP-only bucketing would punish whole shops);
# anonymous callers are bucketed per IP. Narrower limiters (login, privileged
# mutations) still apply on top of these budgets.
# Requests per window, per signed-in user.                (default: 600)
# API_RATE_LIMIT_MAX=600
# Requests per window, per anonymous IP.                  (default: 120)
# API_RATE_LIMIT_ANON_MAX=120
# Window length in milliseconds.                          (default: 60000)
# API_RATE_LIMIT_WINDOW_MS=60000

# Set to "true" when this server backs the Capacitor mobile app. Switches the
# session cookie to SameSite=None and forces Secure, so the WebView's
# cross-origin requests carry it. Leave unset for plain web deployments.
# CAPACITOR_ENABLED=false

# ── WebAuthn / passkeys ────────────────────────────────────────────────────
# Relying-party ID. Must be the site's registrable domain, without scheme or
# port (e.g. "erp.example.com").      (default: the request's hostname)
# PASSKEY_RP_ID=

# Expected origin, including scheme (e.g. "https://erp.example.com").
#                                     (default: derived from the request)
# PASSKEY_ORIGIN=

# ── Emergency master-password impersonation ────────────────────────────────
# DANGEROUS. Lets an operator sign in as any non-Admin, non-Developer user
# with a single shared password. Every use is logged as a security event.
#
# All three variables are required together — setting MASTER_PASSWORD alone
# does nothing, and the capability is refused unless MASTER_PASSWORD_ENABLED
# is exactly "true" AND MASTER_PASSWORD_EXPIRES_AT is a future ISO timestamp.
#
# The expiry is enforced both at process start and on every login attempt, so a
# lapsed window stops working immediately without a restart. The master
# password is never accepted in production, and it can never satisfy the
# confirm-password step-up gate. Unset all three as soon as the incident is over.
# MASTER_PASSWORD=
# MASTER_PASSWORD_ENABLED=false
# MASTER_PASSWORD_EXPIRES_AT=2026-01-01T00:00:00Z


# ═══════════════════════════════════════════════════════════════════════════
# Public application URL / WhatsApp file delivery
# ═══════════════════════════════════════════════════════════════════════════

# Public URL injected by Render. Used as a fallback when building temporary
# file URLs for WhatsApp delivery.
# RENDER_EXTERNAL_URL=

# Optional explicit public base URL for WhatsApp sendFileByUrl delivery.
# When unset, RENDER_EXTERNAL_URL or the trusted request host is used.
# WHATSAPP_PUBLIC_BASE_URL=


# ═══════════════════════════════════════════════════════════════════════════
# AI features
# ═══════════════════════════════════════════════════════════════════════════
# Each provider is optional and independent. The chatbot and AI import
# features stay disabled while the matching key is unset.

# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# Container tracking providers
# ═══════════════════════════════════════════════════════════════════════════
# All optional. Each carrier integration is skipped when its key is missing.

# ── Maersk (needs both) ────────────────────────────────────────────────────
# MAERSK_CONSUMER_KEY=
# MAERSK_CONSUMER_SECRET=

# ── CMA CGM ────────────────────────────────────────────────────────────────
# CMA_CGM_API_KEY=

# ── JSONCargo ──────────────────────────────────────────────────────────────
# JSONCARGO_API_KEY=
# JSONCARGO_BASE_URL=https://app.jsoncargo.com/api/v2
# Hours between ETA refreshes. Deliberately weekly, overriding the provider's
# 24h suggestion.                                           (default: 168)
# JSONCARGO_REFRESH_HOURS=168

# ── ParcelsApp ─────────────────────────────────────────────────────────────
# PARCELSAPP_API_KEY=
# PARCELSAPP_API_BASE_URL=https://parcelsapp.com/api/v3
# Monthly request cap enforced in-app to protect the quota. (default: 500)
# PARCELSAPP_MONTHLY_LIMIT=500

# ── 17TRACK ────────────────────────────────────────────────────────────────
# SEVENTEENTRACK_API_KEY=
# SEVENTEENTRACK_MONTHLY_LIMIT=100

# ── Public (keyless) carrier scraping ──────────────────────────────────────
# Opt-in browser-based tracking for carriers without an API. Set to "true"
# to enable.                                                (default: off)
# PUBLIC_CARRIER_TRACKING_ENABLED=false
# CMA_PUBLIC_TRACKING_ENABLED=false


# ═══════════════════════════════════════════════════════════════════════════
# Headless browser (Puppeteer)
# ═══════════════════════════════════════════════════════════════════════════
# Used by the public carrier scrapers above. Ignored when those are disabled.

# Path to a Chromium binary. Leave unset to use the bundled download.
# PUPPETEER_EXECUTABLE_PATH=

# Concurrent browser sessions.                              (default: 1)
# PUPPETEER_MAX_CONCURRENT=1

# Queued requests before new ones are rejected.             (default: 6)
# PUPPETEER_MAX_QUEUE_DEPTH=6

# Milliseconds a request waits in the queue before giving up. (default: 120000)
# PUPPETEER_QUEUE_WAIT_TIMEOUT_MS=120000


# ═══════════════════════════════════════════════════════════════════════════
# Email
# ═══════════════════════════════════════════════════════════════════════════
# SMTP credentials are stored per-company in the database (Settings → Email),
# not in environment variables.


# ═══════════════════════════════════════════════════════════════════════════
# Observability and alerting
# ═══════════════════════════════════════════════════════════════════════════

# ── Request logging ────────────────────────────────────────────────────────
# Fraction of successful requests to log, 0–1. Errors and slow requests are
# always logged regardless of this rate.                    (default: 0)
# REQUEST_LOG_SAMPLE_RATE=0

# A request slower than this many milliseconds is logged as slow. (default: 500)
# SLOW_REQUEST_MS=500

# Same threshold for outbound calls to external services.   (default: 1500)
# EXTERNAL_DEPENDENCY_SLOW_MS=1500

# ── Client-side error reporting ────────────────────────────────────────────
# Max client error reports accepted per session per window. (default: 20)
# CLIENT_ERROR_RATE_LIMIT=20

# Window in milliseconds for deduplicating identical reports. (default: 60000)
# CLIENT_ERROR_DEDUPE_MS=60000

# ── Alert delivery ─────────────────────────────────────────────────────────
# Set to "true" to evaluate operational alert rules on a timer. (default: off)
# OBSERVABILITY_ALERTS_ENABLED=false

# Milliseconds between evaluations. Floored at 60000.       (default: 60000)
# OBSERVABILITY_ALERT_EVALUATION_MS=60000

# Webhook that fires when an alert rule trips.
# OBSERVABILITY_ALERT_WEBHOOK_URL=
# OBSERVABILITY_ALERT_WEBHOOK_TOKEN=

# Webhook for the general observability event stream (separate from alerts).
# OBSERVABILITY_WEBHOOK_URL=
# OBSERVABILITY_WEBHOOK_TOKEN=

# ── Alert thresholds ───────────────────────────────────────────────────────
# Percentage of requests returning 5xx.
# OPS_SERVER_ERROR_WARNING_PERCENT=1
# OPS_SERVER_ERROR_CRITICAL_PERCENT=5

# Percentage of requests exceeding SLOW_REQUEST_MS.
# OPS_SLOW_REQUEST_WARNING_PERCENT=10
# OPS_SLOW_REQUEST_CRITICAL_PERCENT=30

# Heap usage in megabytes.
# OPS_HEAP_WARNING_MB=768
# OPS_HEAP_CRITICAL_MB=1024

# Clients waiting on a free database connection.
# OPS_DB_POOL_WAITING_WARNING=1

# Recent critical events before the system reports itself unhealthy.
# OPS_RECENT_CRITICAL_EVENTS_WARNING=1

# ── Live screen feed ───────────────────────────────────────────────────────
# Set to "true" to disable the admin live-screen feature.   (default: enabled)
# DISABLE_SCREEN_FEED=false

# ── Debug switches ─────────────────────────────────────────────────────────
# Set to "1" for verbose historical-inventory recalculation logging.
# DEBUG_HISTORICAL_INVENTORY=0


# ═══════════════════════════════════════════════════════════════════════════
# Memory guard
# ═══════════════════════════════════════════════════════════════════════════
# Enabled via the --import preload in `npm start`. Watches RSS and exits the
# process if it stays over the hard limit, so the platform restarts it.

# Soft limit in MB — logs a warning and triggers GC.        (default: 1200)
# MEMORY_SOFT_RSS_MB=1200

# Hard limit in MB.                                         (default: 1500)
# MEMORY_HARD_RSS_MB=1500

# Consecutive samples over the hard limit before exiting.   (default: 4)
# MEMORY_HARD_SAMPLES_BEFORE_EXIT=4

# Milliseconds between RSS samples.                         (default: 15000)
# MEMORY_SAMPLE_INTERVAL_MS=15000

# A heavy endpoint already running holds its slot; further callers wait in a
# short FIFO queue instead of being turned away with ENDPOINT_BUSY.

# How long a queued request waits for a slot before it is
# rejected, in milliseconds.                                (default: 20000)
# ENDPOINT_QUEUE_MAX_WAIT_MS=20000

# How many requests may wait per endpoint before further
# callers are rejected outright.                            (default: 8)
# ENDPOINT_QUEUE_MAX_DEPTH=8


# ═══════════════════════════════════════════════════════════════════════════
# Exports and heavy responses
# ═══════════════════════════════════════════════════════════════════════════

# Concurrent heavy exports (Excel/PDF workbooks).           (default: 1)
# HEAVY_EXPORT_MAX_CONCURRENT=1

# Queued exports before new ones are rejected.              (default: 6)
# HEAVY_EXPORT_MAX_QUEUE=6

# Milliseconds an export waits in the queue.                (default: 900000)
# HEAVY_EXPORT_WAIT_TIMEOUT_MS=900000

# Age in ms before a temporary export archive is cleaned up.
# Values below 60000 are ignored.                           (default: 3600000)
# EXPORT_TEMP_FILE_MAX_AGE_MS=3600000

# Requests that may wait for a busy heavy endpoint before
# further ones are rejected outright.                       (default: 8)
# ENDPOINT_QUEUE_MAX_DEPTH=8

# Milliseconds a request waits for a busy heavy endpoint
# before it is rejected.                                    (default: 20000)
# ENDPOINT_QUEUE_MAX_WAIT_MS=20000

# ── Export buffer bridge (--import preload) ────────────────────────────────
# Streams large export bodies through temp files instead of holding them in
# memory. Set to "1" to disable the bridge entirely.
# EXPORT_BUFFER_BRIDGE_DISABLED=0

# Directory for the bridge's temp files.        (default: the OS temp dir)
# EXPORT_BRIDGE_TEMP_DIR=

# Age in ms before a bridge temp file is deleted.          (default: 21600000)
# EXPORT_BRIDGE_FILE_MAX_AGE_MS=21600000

# Responses at least this many bytes are chunked.          (default: 131072)
# EXPORT_CHUNK_BRIDGE_MIN_BYTES=131072

# ── Scheduled attachment bridge (--import preload) ─────────────────────────
# Attachments at least this many bytes go through the bridge. (default: 131072)
# SCHEDULED_ATTACHMENT_MIN_BYTES=131072

# Milliseconds before a sent attachment's temp file is removed. (default: 900000)
# SCHEDULED_ATTACHMENT_CLEANUP_DELAY_MS=900000

# Same, for attachments that were never sent.              (default: 900000)
# SCHEDULED_ATTACHMENT_ORPHAN_CLEANUP_DELAY_MS=900000

# Set to "1" to route every attachment through the bridge, ignoring the
# size threshold. Diagnostic use only.
# SCHEDULED_ATTACHMENT_FORCE=0


# ═══════════════════════════════════════════════════════════════════════════
# API pagination (--import preload)
# ═══════════════════════════════════════════════════════════════════════════

# Page size when a request omits one.                       (default: 100)
# API_PAGINATION_DEFAULT_LIMIT=100

# Ceiling on a client-requested page size.                  (default: 250)
# API_PAGINATION_MAX_LIMIT=250


# ═══════════════════════════════════════════════════════════════════════════
# Bandwidth diagnostics
# ═══════════════════════════════════════════════════════════════════════════
# Off unless BANDWIDTH_DEBUG is exactly "true". Adds per-response accounting
# and periodic reports — useful for investigation, not for steady-state
# production.

# BANDWIDTH_DEBUG=false

# Responses at least this many KB are logged individually.  (default: 500)
# BANDWIDTH_DEBUG_THRESHOLD_KB=500

# Minutes between summary reports.                          (default: 5)
# BANDWIDTH_DEBUG_REPORT_INTERVAL_MS=5

# Endpoints listed in each report.                          (default: 20)
# BANDWIDTH_DEBUG_TOP_N=20

# Per-window budgets in MB. Exceeding one raises a warning.
# BANDWIDTH_DEBUG_API_WINDOW_BUDGET_MB=50
# BANDWIDTH_DEBUG_STATIC_WINDOW_BUDGET_MB=20
# BANDWIDTH_DEBUG_ENDPOINT_WINDOW_BUDGET_MB=20


# ═══════════════════════════════════════════════════════════════════════════
# Integrations
# ═══════════════════════════════════════════════════════════════════════════

# Repository the in-app update checker reads releases from.
# GITHUB_REPO_URL=
# GITHUB_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════
# Remote support rollout
# ═══════════════════════════════════════════════════════════════════════════
# Controls who can use the remote-support (screen-share assistance) feature.

# general | canary | internal                               (default: general)
#   general  → available to every company
#   canary   → only the companies listed in REMOTE_SUPPORT_CANARY_COMPANY_IDS
#   internal → only the users listed in
#              REMOTE_SUPPORT_INTERNAL_CONTROLLER_USER_IDS
# REMOTE_SUPPORT_ROLLOUT_STAGE=general

# Comma-separated company IDs allowed during the "canary" stage. Non-numeric
# and non-positive entries are ignored.
# REMOTE_SUPPORT_CANARY_COMPANY_IDS=

# Comma-separated user IDs permitted to act as remote-support controllers
# during the "internal" stage.
# REMOTE_SUPPORT_INTERNAL_CONTROLLER_USER_IDS=


# ═══════════════════════════════════════════════════════════════════════════
# Platform-injected (do not set by hand)
# ═══════════════════════════════════════════════════════════════════════════
# The hosting platform sets these. They are listed so their effects are
# discoverable, not so you configure them.
#
#   RENDER               Render: "true" on Render; selects pretty log output.
#   RENDER_GIT_COMMIT    Render: deployed commit SHA; seeds BUILD_VERSION.
#   RENDER_INSTANCE_ID   Render: instance identity used in logs and metrics.
#   RENDER_SERVICE_ID    Render: service identity; marks the runtime as Render
#                        and names the service in log alerts.
#   RENDER_SERVICE_NAME  Render: preferred service label in log alerts.
#   REPL_ID              Replit: presence forces Secure session cookies.
#   REPL_SLUG            Replit: used to build the public dev URL.

