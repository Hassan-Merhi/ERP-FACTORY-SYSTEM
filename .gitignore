node_modules
dist
build
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Security: Exclude sensitive/debug files
attached_assets/
*.sql
*.dump
*.backup
*.log
.env
.env.*
!.env.example
!.env.production
!client/.env.production
!client/.env.capacitor
*.pem
*.key
secrets/

# Android signing — never commit
android/app/*.jks
android/app/*.keystore
android/keystore.properties

# Backup files
*.backup*
*.bak
*~

# Type-check / CI diagnostic dumps (regenerated on demand, never committed)
ts-errors*.txt
*-errors-ci.txt

# Browser smoke screenshots and reports (regenerated on demand)
artifacts/responsive-smoke/
artifacts/bandwidth-smoke/
artifacts/ux-regression-browser/
artifacts/ux-regression-startup/

# ESLint machine report written by scripts/run-lint.mjs (regenerated on demand)
artifacts/lint/
.artifacts/

# CI repair scratch directory: keep the directory addressable so the repair
# workflow's explicit exclude pathspec does not fail, but ignore all contents.
!.ci-repair/
.ci-repair/**

# User-uploaded content (runtime data, not source)
uploads/

# Test coverage output
coverage/
